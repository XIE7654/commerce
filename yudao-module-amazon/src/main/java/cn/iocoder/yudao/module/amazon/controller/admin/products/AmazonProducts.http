### 搜索 Amazon Catalog Items
POST {{baseUrl}}/amazon/products/catalog-items/search
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "keywords": ["wireless", "headphones"],
  "includedData": ["summaries", "attributes", "images"],
  "locale": "en_US",
  "keywordsLocale": "en_US",
  "pageSize": 10
}

### 按 ASIN 查询 Amazon Catalog Item
POST {{baseUrl}}/amazon/products/catalog-items/get
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "asin": "B000000000",
  "includedData": ["summaries", "attributes", "images"],
  "locale": "en_US"
}

### 批量查询 Featured Offer 预期价格
POST {{baseUrl}}/amazon/products/pricing/featured-offer-expected-price
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "body": {
    "requests": [{
      "uri": "/products/pricing/2022-05-01/items/B000000000/featuredOfferExpectedPrice",
      "method": "GET",
      "marketplaceId": "ATVPDKIKX0DER",
      "itemCondition": "New"
    }]
  }
}

### 批量查询商品竞争摘要
POST {{baseUrl}}/amazon/products/pricing/competitive-summary
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "body": {
    "requests": [{
      "marketplaceId": "ATVPDKIKX0DER",
      "asin": "B000000000",
      "includedData": ["featuredBuyingOptions", "referencePrices"],
      "method": "GET",
      "uri": "/products/pricing/2022-05-01/items/competitiveSummary"
    }]
  }
}

### 按 SKU 预估 Amazon 费用
POST {{baseUrl}}/amazon/products/fees/by-sku
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "sellerSku": "SKU-001",
  "body": {
    "FeesEstimateRequest": {
      "MarketplaceId": "ATVPDKIKX0DER",
      "IsAmazonFulfilled": true,
      "PriceToEstimateFees": {"ListingPrice": {"CurrencyCode": "USD", "Amount": 19.99}}
    }
  }
}

### 按 ASIN 预估 Amazon 费用
POST {{baseUrl}}/amazon/products/fees/by-asin
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "asin": "B000000000",
  "body": {
    "FeesEstimateRequest": {
      "MarketplaceId": "ATVPDKIKX0DER",
      "IsAmazonFulfilled": true,
      "PriceToEstimateFees": {"ListingPrice": {"CurrencyCode": "USD", "Amount": 19.99}}
    }
  }
}

### 批量预估 Amazon 费用
POST {{baseUrl}}/amazon/products/fees/batch
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "body": [{
      "MarketplaceId": "ATVPDKIKX0DER",
      "IdType": "ASIN",
      "IdValue": "B000000000",
      "IsAmazonFulfilled": true,
      "PriceToEstimateFees": {"ListingPrice": {"CurrencyCode": "USD", "Amount": 19.99}}
    }]
}

### 搜索 Amazon 商品类型定义
POST {{baseUrl}}/amazon/products/product-types/search
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "keywords": ["headphones"],
  "itemName": "Wireless Headphones",
  "locale": "en_US",
  "searchLocale": "en_US"
}

### 查询 Amazon 商品类型定义
POST {{baseUrl}}/amazon/products/product-types/get
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "productType": "PRODUCT",
  "requirements": "LISTING",
  "requirementsEnforced": "ENFORCED",
  "locale": "en_US"
}
