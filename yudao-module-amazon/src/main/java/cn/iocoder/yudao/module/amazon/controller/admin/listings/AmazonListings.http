### 查询 Amazon Listings Items
POST {{baseUrl}}/amazon/listings/search
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 2,
  "sortBy": "lastUpdatedDate",
  "sortOrder": "DESC",
  "pageSize": 10
}

### 查询 Amazon Listings Items（静态沙盒 Mock）
POST {{baseUrl}}/amazon/listings/search
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 2,
  "identifiers": ["GM-ZDPI-9B4E", "HW-ZDPI-9B4E", "TC-ZDPI-9B4E"],
  "identifiersType": "SKU",
  "includedData": ["summaries", "offers", "fulfillmentAvailability", "issues"],
  "pageSize": 1
}

### 创建或全量更新 Amazon Listings Item
POST {{baseUrl}}/amazon/listings/item/put
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "sku": "SKU-001",
  "productType": "PRODUCT",
  "requirements": "LISTING_OFFER_ONLY",
  "attributes": {
    "fulfillment_availability": [{"fulfillment_channel_code": "DEFAULT", "quantity": 10}]
  },
  "mode": "VALIDATION_PREVIEW"
}

### 局部更新 Amazon Listings Item
POST {{baseUrl}}/amazon/listings/item/patch
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "sku": "SKU-001",
  "productType": "PRODUCT",
  "patches": [{
    "op": "replace",
    "path": "/attributes/fulfillment_availability",
    "value": [{"fulfillment_channel_code": "DEFAULT", "quantity": 10}]
  }],
  "mode": "VALIDATION_PREVIEW"
}

### 删除 Amazon Listings Item
POST {{baseUrl}}/amazon/listings/item/delete
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "sku": "SKU-001",
  "issueLocale": "en_US"
}

### 查询 Amazon Listings 上架限制
POST {{baseUrl}}/amazon/listings/restrictions
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "asin": "B000000000",
  "conditionType": "new_new",
  "reasonLocale": "en_US",
  "productType": "PRODUCT"
}

### 按 SKU 获取 Amazon Listings Item 详情
POST {{baseUrl}}/amazon/listings/item
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "countryCode": "US",
  "sku": "J80US-LDY-5.14",
  "includedData": ["summaries", "attributes", "issues", "offers", "fulfillmentAvailability"],
  "issueLocale": "en_US"
}

### 按 SKU 查询 Amazon Listings Items
POST {{baseUrl}}/amazon/listings/search
Authorization: Bearer {{token}}
Content-Type: application/json
tenant-id: {{adminTenantId}}

{
  "shopId": 1,
  "identifiers": ["SKU-001"],
  "identifiersType": "SKU",
  "includedData": ["summaries", "attributes", "issues"],
  "pageSize": 10
}
