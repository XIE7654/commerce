POST {{baseUrl}}/amazon/shipping/v1/shipments/detail
Authorization: Bearer {{token}}
tenant-id: {{adminTenantId}}
Content-Type: application/json

{"shopId":1,"countryCode":"US","resourceId":"shipment-1"}

