<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.amazon.dal.mysql.shop.AmazonShopMapper">

    <resultMap id="AmazonShopWithMarketplacesResultMap"
               type="cn.iocoder.yudao.module.amazon.dal.dataobject.shop.AmazonShopWithMarketplacesDO">
        <association property="shop" javaType="cn.iocoder.yudao.module.amazon.dal.dataobject.shop.AmazonShopDO">
            <id property="id" column="shop_id"/>
            <result property="marketplaceId" column="shop_marketplace_id"/>
        </association>
        <collection property="participations"
                    ofType="cn.iocoder.yudao.module.amazon.dal.dataobject.seller.AmazonShopMarketplaceDO">
            <id property="id" column="participation_id"/>
            <result property="shopId" column="participation_shop_id"/>
            <result property="marketplaceId" column="participation_marketplace_id"/>
            <result property="countryCode" column="participation_country_code"/>
            <result property="isParticipating" column="participation_is_participating"/>
        </collection>
    </resultMap>

    <select id="selectEnabledWithMarketplaces" resultMap="AmazonShopWithMarketplacesResultMap">
        SELECT s.id AS shop_id,
               s.marketplace_id AS shop_marketplace_id,
               p.id AS participation_id,
               p.shop_id AS participation_shop_id,
               p.marketplace_id AS participation_marketplace_id,
               p.country_code AS participation_country_code,
               p.is_participating AS participation_is_participating
        FROM amazon_shop s
        LEFT JOIN amazon_shop_marketplace p
               ON p.shop_id = s.id
              AND p.tenant_id = s.tenant_id
              AND p.is_participating = 1
        WHERE s.status = 0
        ORDER BY s.id, p.id
    </select>

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
     -->

</mapper>
